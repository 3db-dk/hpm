---
source: crates/hpm-cli/tests/cli_snapshots.rs
expression: env.mask(&report)
---
paths:
.gitignore
README.md
config
config/.gitkeep
hpm.toml
otls
otls/.gitkeep
package.json
presets
presets/.gitkeep
python
python/__init__.py
scripts
scripts/.gitkeep
tests
tests/.gitkeep

--- hpm.toml
[package]
path = "local/demo-pkg"
name = "demo-pkg"
version = "0.1.0"
license = "MIT"
readme = "README.md"
keywords = ["houdini"]

[compat]
houdini = "^21"

--- package.json
{
  "hpath": [
    "$HPM_PACKAGE_ROOT"
  ],
  "env": [
    {
      "PYTHONPATH": {
        "method": "prepend",
        "value": [
          "$HPM_PACKAGE_ROOT/python"
        ]
      }
    },
    {
      "HOUDINI_SCRIPT_PATH": {
        "method": "prepend",
        "value": [
          "$HPM_PACKAGE_ROOT/scripts"
        ]
      }
    }
  ],
  "enable": "houdini_version >= '21' and houdini_version < '22'"
}
--- README.md
# demo-pkg

A Houdini package

## Installation

Install using HPM:

```bash
hpm add local/demo-pkg
```

## Usage

This package provides Houdini assets and tools for enhanced workflow capabilities.

## Development

### Building

```bash
hpm run build
```

### Testing

```bash
hpm run test
```

## License

MIT

